import test
import tty
import set
import map

import lib/utils
import lib/net/net
import lib/language/lc/compiler
import lib/language/lc/term
import lib/language/ic/term
import lib/language/ic/ruler

// normalize is non-deterministic
def confluence(n: Int) { test: => Unit / Assertion }: Unit / Assertion = {
  0.each(n) { i =>
    try test()
    with Assertion {
      def assert(condition, msg, loc) = resume(do assert(condition, s"${msg} (run number ${i.show})", loc))
    }
  }
  test()
}

def render(ctors: List[Constructor], wires: Map[String, List[Int]], root: Int): (String, Set[Int]) = {
  with on[OutOfBounds].panic() // `wires` only ever points into `ctors`

  var names: Map[String, String] = empty(box compareStringBytes) // port name -> traversal index
  var counter = 0
  var component: Set[Int] = empty(box compareInt)
  var rendered: List[String] = Nil()

  def number(port: SuperPort): Unit =
    if (not(names.map::contains(port.name))) {
      names = names.put(port.name, counter.show)
      counter = counter + 1
    }

  def visit(i: Int): Unit =
    if (not(component.set::contains(i))) {
      component = component.insert(i)
      val ctor = ctors.get(i)
      ctor.ports.foreach { port => number(port) } // principal port first, then auxiliary
      rendered = Cons(ctor.map { port => names.getOrElse(port.name) { port.name }.ref }.pretty, rendered)
      ctor.ports.foreach { port =>
        wires.getOrElse(port.name) { Nil() }.foreach { partner => if (partner != i) visit(partner) }
      }
    }

  visit(root)
  (rendered.reverse.join(", "), component)
}

def canonical(ctors: List[Constructor]): String = {
  var wires: Map[String, List[Int]] = empty(box compareStringBytes) // port name -> constructors sharing it
  ctors.foreachIndex { (i, ctor) =>
    ctor.ports.foreach { port =>
      wires = wires.put(port.name, Cons(i, wires.getOrElse(port.name) { Nil() }))
    }
  }

  def go(remaining: List[Int], components: List[String]): List[String] = remaining match {
    case Nil() => components.sortBy { (a, b) => a <= b }
    case Cons(root, _) =>
      val (rendering, component) = ctors.render(wires, root)
      val best = component.toList.foldLeft(rendering) { (best, start) =>
        val candidate = ctors.render(wires, start).first
        if (candidate <= best) candidate else best
      }
      go(remaining.filter { i => not(component.set::contains(i)) }, Cons(best, components))
  }

  go(list::build(ctors.size) { i => i }, Nil()).join(" | ")
}

def assertEquivalent(bs: List[Constructor], as: List[Constructor]): Unit / { Formatted, Assertion } =
  assertEqual(bs, as, s"expected an equivalent net, but got\n${bs.pretty}\n vs\n${as.pretty}") {
    (b, a) => b.canonical == a.canonical
  }

record Confluence(value: Int)
record Steps(value: Int)

def normalizeWith(term: String, conf: Confluence, steps: Steps, normalized: List[Constructor]) = {
  with confluence(conf.value)
  val program: Program = collect {
    with assertNoThrow[WrongFormat]
    with source[Char] { term.each }
    compile!()
  }
  val redexes = box { program.redexes() }
  val (_normalized, _steps) = normalize(program, redexes, steps.value + 10)
  assertEqual(_steps, steps.value)
  assertEquivalent(list::collect[Constructor] { _normalized() }, normalized)
}

def tests() = suite("└ ruler tests") {
  test("normalization: identity application") {
    with confluence(5)
    val program: Program = collect {
      with assertNoThrow[WrongFormat]
      with source[Char] { "(x=>x x=>x)".each }
      compile!()
    }
    val redexes = box { program.redexes() }
    assertEqual(list::collect[Redex] { redexes() }, [
      Redex(
        Applicator(Neg("kAbs2".ref), Neg("kAbs4".ref), Pos("kApp5".ref)),
        Abstractor(Pos("xSym1".ref), Neg("xSym1".ref), Pos("kAbs2".ref)))
    ]) { (a, b) => a == b } { r => r.pretty }
    val (normalized, steps) = normalize(program, redexes, 10)
    assertEqual(steps, 1)
    assertEquivalent(list::collect[Constructor] { normalized() }, [
      Abstractor(Pos("xSym3".ref), Neg("xSym3".ref), Pos("xSym1".ref)),
      Initiator(Neg("xSym1".ref))
    ])
  }

  test("normalization: identity duplication") {
    "(x=>(x x) x=>x)".normalizeWith(Confluence(5), Steps(4), [
      Abstractor(Pos("xSym6_1_1".ref), Neg("xSym6_1_1".ref), Pos("xSym6_0_0".ref)),
      Initiator(Neg("xSym6_0_0".ref))
    ])
  }

  test("normalization: more complex identity annihilation") {
    "(x=>x x=>(x x) x=>x)".normalizeWith(Confluence(50), Steps(5), [
      Abstractor(Pos("xSym9_1_1".ref), Neg("xSym9_1_1".ref), Pos("xSym9_0_0".ref)),
      Initiator(Neg("xSym9_0_0".ref))
    ])
  }

  test("normalization: multi-dup identity annihilation") {
    "(x=>(x x x x x x x x x) x=>x)".normalizeWith(Confluence(50), Steps(11), [
      Abstractor(Pos("xSym9_1_1".ref), Neg("xSym9_1_1".ref), Pos("xSym9_0_0".ref)),
      Initiator(Neg("xSym9_0_0".ref))
    ])
  }

  test("normalization: church identity annihilation") {
    "(s=>z=>(s (s (s (s (s (s z)))))) x=>x)".normalizeWith(Confluence(50), Steps(9), [
      Abstractor(Pos("xSym9_1_1".ref), Neg("xSym9_1_1".ref), Pos("kAbs6".ref)),
      Initiator(Neg("kAbs6".ref))
    ])
  }

  test("normalization: church i* annihilation") {
    "(s=>z=>(s (s (s (s (s (s z)))))) x=>y=>(x y))".normalizeWith(Confluence(50), Steps(17), [
      Applicator(Neg("xSym17_5_5".ref), Neg("ySym18_17_5".ref), Pos("kApp19_19_1".ref)), // (x y)
      Abstractor(Pos("ySym18_17_5".ref), Neg("kApp19_19_1".ref), Pos("kAbs20_6_0".ref)), // y =>
      Abstractor(Pos("xSym17_5_5".ref), Neg("kAbs20_6_0".ref), Pos("kAbs14".ref)),       // x =>
      Initiator(Neg("kAbs14".ref))
    ])
  }

  test("normalization: church bruijnification") {
    "(s=>z=>(s (s z)) x=>y=>x)".normalizeWith(Confluence(50), Steps(7), [
      Duplicator(Neg("yEra11_4_0".ref), Nil(), 1),
      Duplicator(Neg("yEra11_5_1".ref), Nil(), 1),
      Abstractor(Pos("yEra11_4_0".ref), Neg("xSym9_0_0".ref), Pos("kAbs10_2_0".ref)), // y11_4 =>
      Abstractor(Pos("yEra11_5_1".ref), Neg("xSym9_1_1".ref), Pos("xSym9_0_0".ref)),  // y11_5 =>
      Abstractor(Pos("xSym9_1_1".ref), Neg("kAbs10_2_0".ref), Pos("kAbs6".ref)),      // x9 =>
      Initiator(Neg("kAbs6".ref))
    ])
  }

  test("normalization: erasing church") {
    "(x=>y=>y s=>z=>(s (s (s z))))".normalizeWith(Confluence(50), Steps(11), [
      Abstractor(Pos("ySym1".ref), Neg("ySym1".ref), Pos("kAbs2".ref)),
      Initiator(Neg("kAbs2".ref))
    ])
  }

  test("normalization: s k k") {
    "(x=>y=>z=>(x z (y z)) x=>y=>x x=>y=>x)".normalizeWith(Confluence(50), Steps(7), [
      Duplicator(Neg("zSym5".ref), Nil(), 1),
      Duplicator(Neg("zDup9".ref), [Pos("zSym2".ref), Pos("zSym5".ref)], 0),
      Abstractor(Pos("zDup9".ref), Neg("zSym2".ref), Pos("kAbs8".ref)),
      Initiator(Neg("kAbs8".ref))
    ])
  }

  val iota = "s=>(s x=>y=>z=>(x z (y z)) x=>y=>x)"

  test("normalization: iota iota") {
    s"(${iota} ${iota})".normalizeWith(Confluence(50), Steps(19), [
      Duplicator(Neg("zDup29".ref), [Pos("zSym22".ref), Pos("zSym25".ref)], 2),
      Abstractor(Pos("zDup29".ref), Neg("zSym22".ref), Pos("kAbs28".ref)),
      Duplicator(Neg("zSym25".ref), [], 2),
      Initiator(Neg("kAbs28".ref))
    ])
  }

  test("normalization: iota iota iota iota") {
    s"(${iota} (${iota} (${iota} ${iota})))".normalizeWith(Confluence(50), Steps(67), [
      Duplicator(Neg("38".ref), Nil(), 1),
      Abstractor(Pos("38".ref), Neg("34".ref), Pos("36".ref)),   // y => x
      Abstractor(Pos("34".ref), Neg("36".ref), Pos("32_0".ref)), // x =>
      Initiator(Neg("32_0".ref))
    ])
  }
}
